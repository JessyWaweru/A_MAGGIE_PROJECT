# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local sqlite for development.
# In production (Render): a managed Postgres instance. Use its *Internal* Database
# URL (Render dashboard -> the Postgres service -> Connections) when the backend
# web service lives in the same Render region - it's free and faster than External.
# DATABASE_URL=postgres://user:password@localhost:5432/herbmed

TIME_ZONE=Africa/Nairobi

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Email - leave EMAIL_BACKEND as console for local dev (emails print to the terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# In production, use Resend's SMTP relay (https://resend.com/docs/send-with-smtp):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=<your Resend API key>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=GOherbal <no-reply@goherbal.health>

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Resend inbound-email webhook signing secret (dashboard → Webhooks → your endpoint → Signing Secret, starts "whsec_")
RESEND_INBOUND_WEBHOOK_SECRET=
PAYMENT_CURRENCY=KES

# Cloudflare Turnstile secret. Dev uses Cloudflare's always-pass test key; set the real one in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Auth cookies. Defaults are right when the site and API share a domain
# (goherbal.health + api.goherbal.health). Secure is on automatically when DEBUG is off.
# AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_SECURE=True

# Logo at the top of every email (must be a public https URL). Defaults to the live site.
# EMAIL_LOGO_URL=https://goherbal.health/brand/goherbal-logo-email.png
